<section class="band" id="{{ section.settings.anchor }}" aria-labelledby="t-{{ section.id }}">
  <div class="wrap">
    <div class="band-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="t-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif -%}
    </div>
    <div class="uses">
      {%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Ideas grid",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "uses" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ideas" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One fan, a different show every season" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [ { "type": "idea", "name": "Idea", "settings": [
    { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" } ] } ],
  "presets": [ { "name": "Ideas grid" } ]
}
{% endschema %}

<section class="band" id="signup" aria-labelledby="t-{{ section.id }}">
  <div class="wrap signup">
    <div class="band-head" style="margin-bottom:0">
      <h2 id="t-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div>
      {%- form 'customer', id: 'signup', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="email-{{ section.id }}" class="opt-label" style="flex-basis:100%;margin:0">Email address</label>
        <input type="email" id="email-{{ section.id }}" name="contact[email]" placeholder="you@example.com" autocomplete="email" required>
        <button type="submit">{{ section.settings.button }}</button>
        {%- if form.posted_successfully? -%}
          <p class="msg" role="status" style="flex-basis:100%">{{ section.settings.success }}</p>
        {%- elsif form.errors -%}
          <p class="msg" role="alert" style="flex-basis:100%;color:var(--festive)">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Email sign-up",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get £5 off your first order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the list for new hologram ideas and members-only deals. No spam." },
    { "type": "text", "id": "button", "label": "Button", "default": "Get my code" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're on the list! Use code WELCOME5 at checkout for £5 off." }
  ],
  "presets": [ { "name": "Email sign-up" } ]
}
{% endschema %}

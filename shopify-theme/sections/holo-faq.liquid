<section class="band" id="{{ section.settings.anchor }}" aria-labelledby="t-{{ section.id }}">
  <div class="wrap faq">
    <div class="band-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="t-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>Something else? Email <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a> and we'll reply within one working day.</p>
    </div>
    <div>
      {%- for b in section.blocks -%}<details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><p>{{ b.settings.a }}</p></details>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" }
  ],
  "blocks": [ { "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "q", "label": "Question" }, { "type": "textarea", "id": "a", "label": "Answer" } ] } ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}

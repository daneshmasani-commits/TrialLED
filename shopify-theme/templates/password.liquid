<section class="wrap page" style="min-height:60vh;align-content:center">
  <p class="eyebrow">Opening soon</p><h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank %}<p class="rte">{{ shop.password_message }}</p>{% endif -%}
  {%- form 'customer', class: 'form-stack' -%}<input type="hidden" name="contact[tags]" value="prospect,password page"><input type="email" name="contact[email]" placeholder="you@example.com" aria-label="Email" required><button class="btn" type="submit">Notify me</button>{%- if form.posted_successfully? %}<p>Thanks, we'll let you know.</p>{% endif -%}{%- endform -%}
  <details><summary>Store owner? Enter password</summary>
  {%- form 'storefront_password', class: 'form-stack' -%}{{ form.errors | default_errors }}<input type="password" name="password" aria-label="Password" placeholder="Password"><button class="btn" type="submit">Enter</button>{%- endform -%}</details>
</section>

<section class="wrap page"><h1>Create account</h1>
{%- form 'create_customer', class: 'form-stack' -%}{{ form.errors | default_errors }}
<input type="text" name="customer[first_name]" placeholder="First name" aria-label="First name"><input type="text" name="customer[last_name]" placeholder="Last name" aria-label="Last name">
<input type="email" name="customer[email]" placeholder="Email" aria-label="Email"><input type="password" name="customer[password]" placeholder="Password" aria-label="Password">
<button class="btn" type="submit">Create</button>{%- endform -%}</section>

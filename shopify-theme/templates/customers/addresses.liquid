<section class="wrap page"><h1>Addresses</h1><p><a href="{{ routes.account_url }}">Back to account</a></p>
{%- for a in customer.addresses -%}<p>{{ a | format_address }}</p>{%- endfor -%}
{%- form 'customer_address', customer.new_address, class: 'form-stack' -%}<h2>Add address</h2>
<input name="address[first_name]" placeholder="First name" aria-label="First name"><input name="address[last_name]" placeholder="Last name" aria-label="Last name"><input name="address[address1]" placeholder="Address" aria-label="Address"><input name="address[city]" placeholder="Town" aria-label="Town"><input name="address[zip]" placeholder="Postcode" aria-label="Postcode"><input name="address[country]" value="United Kingdom" aria-label="Country">
<button class="btn" type="submit">Save</button>{%- endform -%}</section>

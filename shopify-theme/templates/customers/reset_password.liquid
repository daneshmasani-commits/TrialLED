<section class="wrap page"><h1>Reset password</h1>{%- form 'reset_customer_password', class: 'form-stack' -%}{{ form.errors | default_errors }}<input type="password" name="customer[password]" placeholder="New password" aria-label="New password"><input type="password" name="customer[password_confirmation]" placeholder="Confirm" aria-label="Confirm password"><button class="btn" type="submit">Reset</button>{%- endform -%}</section>

<section class="wrap page"><h1>Order {{ order.name }}</h1><p><a href="{{ routes.account_url }}">Back to account</a></p>
<table class="simple"><tbody>{%- for li in order.line_items -%}<tr><td>{{ li.title }}</td><td>×{{ li.quantity }}</td><td>{{ li.final_line_price | money }}</td></tr>{%- endfor -%}</tbody></table>
<p><strong>Total {{ order.total_price | money }}</strong></p></section>

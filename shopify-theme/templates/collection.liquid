<section class="wrap page">
  <h1>{{ collection.title }}</h1>
  {%- paginate collection.products by 24 -%}
  <div class="grid-list">
    {%- for p in collection.products -%}
      <a class="card" href="{{ p.url }}">{% if p.featured_image %}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif %}<strong>{{ p.title }}</strong><span>{{ p.price | money }}</span></a>
    {%- else -%}<p class="rte">No products yet.</p>{%- endfor -%}
  </div>
  {{ paginate | default_pagination }}
  {%- endpaginate -%}
</section>
